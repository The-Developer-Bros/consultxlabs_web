  OFFLINE
}

model MaintenanceWindow {
  id           String           @id @default(cuid())
  phase        MaintenancePhase @default(OFF)
  reason       String?
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  estimatedEnd DateTime?
  startedBy    String?
  endedBy      String?
  bypassSecret String?

  /// PR #655 Tier 1 multi-tenant column. NULL = platform-wide window
  /// (every legacy row + the default for ops-triggered downtime).
  /// Non-null = the window only affects the matching tenant; other
  /// orgs see the platform stay green. The per-org admin API and
  /// Novu workflow scoping that uses this column land post-MVP in
  /// #730 — the column exists today so the migration doesn't have
  /// to ship with the feature work.
