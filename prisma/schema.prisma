  // Essential: Core functionality - auth, security, CSRF (cannot be disabled)
  essential Boolean @default(true)

  // Analytics: Usage tracking - GA4, Hotjar, Mixpanel, PostHog
  analytics Boolean @default(false)

  // Marketing: Advertising - Facebook Pixel, Google Ads, LinkedIn, TikTok
  marketing Boolean @default(false)

  // Functional: Third-party features - chat widgets (Intercom), video embeds
  functional Boolean @default(false)

  // Consent timestamps for GDPR compliance
