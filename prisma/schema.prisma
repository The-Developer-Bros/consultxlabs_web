// #705 schema freeze (2026-07-17) — enterprise schema is launch-frozen.
// Additive-only until launch: new nullable columns / new models are allowed;
// renames, drops of live columns, and type changes are not. Money columns are
// BigInt paise; enums are declared below the model(s) that use them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Database URLs are now configured in prisma.config.ts (Prisma 7)
}

////////////////////////////////////////// USER MODEL //////////////////////////////////////////

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  phone               String?   @unique
  address             String?
  onlineStatus        Boolean   @default(false)
  timezone            String?
  onboardingCompleted Boolean?  @default(false)
  role                UserRole? @default(CONSULTEE)

  // New fields for enhanced user profile
  dateOfBirth         DateTime?
  gender              Gender?
  city                String?
  country             String?
  linkedinUrl         String?
  bio                 String?   @db.VarChar(160) // Short tagline, max 160 chars
  profileDisplayImage String? // Square profile image for Explore Experts page

  // Consent timestamps
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?

  // Professional background (consolidated from profile level)
  workExperiences WorkExperience[]
  certifications  Certification[]
  education       Education[]

  cookiePreferences       CookiePreference?
  notificationPreferences NotificationPreference?
  Payment                 Payment[]
  // #1365 — B2C tax invoices issued to this buyer.
  consumerInvoices        ConsumerInvoice[]

  // Relations
  consultantProfile     ConsultantProfile?
  consultantProfileId   String?              @unique
  consulteeProfile      ConsulteeProfile?
  consulteeProfileId    String?              @unique
  staffProfile          StaffProfile?
  staffProfileId        String?              @unique
  adminProfile          AdminProfile?
  adminProfileId        String?              @unique
  orgWorkspaceProfile   OrgWorkspaceProfile?
  orgWorkspaceProfileId String?              @unique

  slotsOfAppointment SlotOfAppointment[] @relation("SlotOfAppointmentToUser")

  rescheduleRequestsInitiated RescheduleRequest[]      @relation("RescheduleInitiator")
  // #1319 — A9 participant edge, A12 status-history actor, cancelledBy FKs.
  appointmentParticipations   AppointmentParticipant[]
  bookingStatusActions        BookingStatusHistory[]   @relation("BookingStatusHistoryActor")
  consultationsCancelled      Consultation[]           @relation("ConsultationCancelledBy")
  subscriptionsCancelled      Subscription[]           @relation("SubscriptionCancelledBy")
  rescheduleRequestsResolved  RescheduleRequest[]      @relation("RescheduleResolver")
  rescheduleSlotsProposed     RescheduleProposedSlot[] @relation("ProposedSlotAuthor")

  // Newsletter signup, when the subscriber was signed in at the time.
  waitlistSubscriptions Waitlist[]

  // Feedback and Support
  feedbacks                 Feedback[]
  supportTickets            SupportTicket[]
  // #appt-support — per-appointment support conversations + private CSAT.
  appointmentSupportThreads AppointmentSupportThread[]
  appointmentFeedback       AppointmentFeedback[]
  supportResponses          SupportResponse[]
  supportTicketsAssigned    SupportTicket[]            @relation("SupportTicketAssignee")
  supportMessagesAuthored   SupportMessage[]           @relation("SupportMessageAuthor")
  supportFlowOutcomes       SupportFlowOutcome[]

  accounts         Account[] // BetterAuth Accounts
  sessions         Session[] // BetterAuth Sessions
  members          Member[] // BetterAuth membership rows
  memberships      Membership[] // Typed enterprise memberships (Arch 4-Modified)
  invitationsSent  Invitation[]      @relation("InvitationsSent")
  consentArtifacts ConsentArtifact[]
  dpdpGrievances   DpdpGrievance[]

  // Staff Dashboard Relations
  reportsSubmitted  ModerationReport[] @relation("ReportsSubmitted")
  reportsReceived   ModerationReport[] @relation("ReportsReceived")
  moderationActions ModerationAction[]

  // Referral system
  referralCode    ReferralCode?
  referral        Referral?        @relation("ReferredUser")
  referralCredits ReferralCredit[]

  // In-progress onboarding wizard state (resumable drafts). At most one row
  // per user; deleted when onboarding completes. See OnboardingDraft below.
  onboardingDraft OnboardingDraft?

  // Session-generation marker: increments on every membership role
  // change so the next request through `customSession` (see
  // `lib/auth.ts`) detects "I'm out of date" and refetches memberships
  // without forcing a logout. Carried into the session payload via
  // BetterAuth's `additionalFields`; the customSession callback
  // compares the carried value to this row value on each lookup.
  //
  // Why a counter and not a boolean "stale" flag: under concurrent
  // role mutations, a boolean races between writer and reader. A
  // monotonic integer makes each session's "I've seen up to N" check
  // unambiguous. See audit Phase B.5 + docs/enterprise/20-iam-and-security/02-jit-and-session-refresh.md.
  sessionGeneration Int @default(0)

  // DPDP §12 right-to-erasure tombstone marker (audit Phase 2). When set,
  // the user's PII fields are scrubbed to pseudonymous values and every
  // active Membership is flipped to MemberStatus.ERASED. Financial rows
  // (invoices, payouts, ledger entries) are intentionally retained per
  // IT Act 5–7y obligations — the erasure is selective, not destructive.
  // SCIM and JIT re-creation paths must return 410 Gone when erasedAt is set.
  erasedAt       DateTime?
  // SHA-256(userId + salt) — opaque stable id used to rewrite audit-log
  // JSON references after scrub so historical investigations still trace
  // events back to a (deterministic) actor without exposing PII.
  pseudonymousId String?   @unique

  // BetterAuth admin-plugin fields (#693 moderation, starts #725 Tier-1).
  // Suspension = banned:true + banExpires set (lazy expiry, plugin auto-unbans
  // at sign-in); permanent ban = banned:true + banExpires:null. Who/when/why
  // lives in ModerationAction, not here.
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime? @db.Timestamptz

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitations               Invitation[]
  ssoproviders              SsoProvider[]
  erasureRequests           ErasureRequest[]
  /// Erasure requests this user processed as an admin. Named relation
  /// distinguishes it from `erasureRequests` above (requests filed
  /// against this user) — Prisma requires the disambiguation since
  /// both edges target ErasureRequest.
  erasureRequestsProcessed  ErasureRequest[]      @relation("ErasureRequestProcessor")
  // Disputes this admin owns (#269).
  disputesAssigned          Dispute[]             @relation("DisputeAssignee")
  // A8 — documents this consultant reviewed (back-relation for the FK-ified
  // AppointmentDocument.reviewedById; named to avoid the implicit-relation guess).
  documentsReviewed         AppointmentDocument[] @relation("DocumentReviewer")
  // Soft-delete audit — who tombstoned an appointment document.
  documentsDeleted          AppointmentDocument[] @relation("DocumentDeleter")
  // #366 — publish-time redistribution-consent attestations made by consultants.
  recordingsConsentAttested Recording[]           @relation("RecordingConsentAttestor")
  // #366 — replay purchases this user made.
  recordingPurchases        RecordingPurchase[]   @relation("RecordingPurchaseBuyer")

  @@index([consultantProfileId])
  @@index([consulteeProfileId])
  @@index([adminProfileId])
  @@index([role])
  @@index([staffProfileId])
  @@index([orgWorkspaceProfileId])
  @@index([erasedAt])
  @@map("users")
}

/// Server-side draft of an in-progress onboarding wizard run. The wizard
/// autosaves after every step so a refresh, navigation, or device switch can
/// resume instead of restarting. One row per user (userId @unique); the row is
/// deleted when onboarding completes and is never read by any guard —
/// `onboardingCompleted` remains the single source of truth for access.
///
/// Additive under the #705 schema freeze: new model + one nullable relation,
/// no existing column touched.
model OnboardingDraft {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  /// Role picked at step 0 (null until then). Mirrors User.role's enum but is
  /// informational only — the authoritative role flip still happens through
  /// setOnboardingRoleAction / processOnboardingData.
  role UserRole?

  /// Zero-based index into the role's step registry.
  currentStep Int @default(0)

  /// JSON-serialized Partial<OnboardingFormData> with non-JSON values
  /// (File/Blob/Date instances) sanitized by the writer. Dates are stored as
  /// ISO strings and revived by the reader's Zod schema.
  ///
  /// Why JSONB here and not normalized tables (deliberate, per the
  /// #onboarding-ux decision record in docs/onboarding):
  ///   * The payload's shape MIRRORS THE WIZARD UI, so it changes whenever
  ///     the wizard does — normalizing would couple DB migrations to form
  ///     tweaks; an EAV key/value table was rejected as strictly worse
  ///     (untyped values AND row explosion).
  ///   * It is always read/written AS A WHOLE document — no code filters,
  ///     joins, or aggregates inside it. The queryable keys (userId, role,
  ///     currentStep) ARE real columns above; this is the standard
  ///     "stable columns + volatile blob" hybrid.
  ///   * It never becomes truth. The single writer of real data remains the
  ///     Zod-validated big-bang transaction into fully-normalized tables;
  ///     this row is a convenience cache deleted on completion.
  ///   * The real tables CANNOT be reused as draft storage. Achievement and
  ///     SlotOfAvailabilityWeekly both require a consultantProfileId, and no
  ///     consultant profile exists until processOnboardingData creates one at
  ///     the very end of the wizard. Drafting into them would mean either
  ///     creating a half-built profile hours before the user commits to being
  ///     a consultant, or duplicating each table with a nullable FK — which
  ///     is the mirror below, not reuse.
  ///   * A mirror would not buy stronger typing. Every mirrored column has to
  ///     be nullable, because a draft is by definition incomplete: the user
  ///     may have typed a job title and no dates. Every enum column becomes a
  ///     liability for the same reason — a half-picked ScheduleType has no
  ///     legal value to store. So a ten-table mirror is not typed storage; it
  ///     is weak typing spread across ten tables, ten sets of FKs to keep
  ///     consistent, and a migration for every form tweak.
  ///
  /// What the blob COSTS, honestly: the database enforces nothing about the
  /// contents, so every consumer has to defend itself. That defence is real
  /// code, not a footnote — a structural Zod schema at the write boundary
  /// (utils/onboarding-draft.ts) that strips unknown keys and proves arrays
  /// are arrays, a `__v` generation marker so a payload from an older wizard
  /// is quarantined instead of merged, an application byte gate plus the
  /// pg_column_size CHECK in prisma/sql/check-constraints.sql, and
  /// prototype-chain-safe lookups wherever the wizard reads a value back out
  /// (`Object.hasOwn`, never `in`). The trade is deliberate, but it is a
  /// trade: the schema flexibility is paid for at every read site.
  ///
  /// Promotion rule: if ops ever needs to filter/report INSIDE payloads,
  /// promote that key to a real column instead of querying the blob.
  payload Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("onboarding_drafts")
}

model Feedback {
  id          String         @id @default(uuid())
  title       String
  description String         @db.Text
  rating      Int?           @db.SmallInt
  category    String?
  status      FeedbackStatus @default(PENDING)

  user   User   @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SupportTicket {
  id             String              @id @default(uuid())
  title          String
  description    String              @db.Text
  priority       SupportPriority     @default(MEDIUM)
  status         SupportTicketStatus @default(OPEN)
  category       String?
  // #1021 — org context so enterprise tickets can be routed, SLA-tracked,
  // and counted per organisation instead of disappearing into the B2C queue.
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  issueType      SupportIssueType?

  // #705 — a speakable handle for email subjects and phone support. A uuid
  // cannot be read back over a phone line, so the two staff surfaces had each
  // invented their own truncation (one took the first 8 chars, the other the
  // last) and users were given nothing at all. Year-scoped so the series leaks
  // this year's volume rather than the all-time count. Nullable because it is
  // minted forward-only: a unique index permits unlimited NULLs, so tickets
  // that predate it keep their uuid and no backfill is owed.
  referenceNumber String? @unique @db.VarChar(20)

  user   User   @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userId String

  responses                SupportResponse[]
  attachments              SupportTicketAttachment[]
  // #appt-support — set when a per-appointment thread escalates to a human, so
  // ops works it in this existing queue rather than a parallel system.
  appointmentSupportThread AppointmentSupportThread?

  // #support-hub — denormalized last-activity clock, bumped transactionally on
  // every visible message write. `updatedAt` only moves when THIS row changes,
  // so replies would leave it stale; the hub and the ops inbox sort by this.
  lastMessageAt DateTime?

  // Entity links for Swiggy-style context (link ticket to booking/payment)
  consultationId String?
  subscriptionId String?
  paymentId      String?
  refundId       String? // If refund was initiated from this ticket

  // Staff assignment. #705 — was a bare String, so it could name a user who no
  // longer exists and the ops queue could not render a name without a second
  // query. SetNull, never Cascade: a staff departure must not delete tickets.
  assignedTo   User?   @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  // #705 — SLA deadlines, STORED at intake rather than derived at read time so
  // a later policy change never retroactively re-dates an open ticket's breach
  // (same rationale as Appointment.cancellationPolicySnapshot). Sized to the
  // IT Rules 2021 numbers — acknowledge <= 24h, dispose <= 15 days — because
  // they are tighter than the Consumer Protection (E-Commerce) Rules 2020, so
  // meeting them satisfies both. No `slaState` column: every state is derivable
  // from these stamps plus now(), and a stored one would go stale between cron
  // runs. NULL on tickets that predate this; lib/support/sla.ts falls back to
  // createdAt + the statutory window, which is why no backfill is owed.
  ackDueAt          DateTime? @db.Timestamptz
  acknowledgedAt    DateTime? @db.Timestamptz
  resolutionDueAt   DateTime? @db.Timestamptz
  resolvedAt        DateTime? @db.Timestamptz
  closedAt          DateTime? @db.Timestamptz
  // First reply from a person. Distinct from acknowledgedAt, which an automated
  // acknowledgement satisfies; this is the number that actually predicts CSAT.
  firstAgentReplyAt DateTime? @db.Timestamptz
  // The resolution clock stops while the ball is in the user's court, or every
  // slow-replying customer reads as a team breach. Staff's reply sets
  // `awaitingUserSince`; the user's reply folds the elapsed wait into
  // `pausedSeconds` and clears it. Effective deadline =
  // resolutionDueAt + pausedSeconds.
  //
  // SECONDS, not milliseconds: an Int of ms overflows at 24.8 days, which a
  // ticket that sits on the user for a couple of months would reach. Seconds
  // buy 68 years, and sub-second precision is meaningless against a deadline
  // measured in days.
  awaitingUserSince DateTime? @db.Timestamptz
  pausedSeconds     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
  @@index([consultationId])
  @@index([paymentId])
  @@index([createdAt])
  @@index([assignedToId, status])
  // #support-hub — org-filtered ops queue views. This also serves the
  // organizationId-only lookups #1245 r2 added a single-column index for:
  // Postgres reads a composite's leftmost prefix, so that index was pure
  // write cost. Removed here rather than left shadowing this one.
  @@index([organizationId, status])
  // #705 — breach sweeps: "unacknowledged and past due", "unresolved and past
  // due". Without these, finding a breach means scanning the whole queue.
  @@index([acknowledgedAt, ackDueAt])
  @@index([resolvedAt, resolutionDueAt])
}

// #705 — per-year counter behind SupportTicket.referenceNumber. Allocation is
// an INSERT…ON CONFLICT DO UPDATE…RETURNING, so concurrent ticket creation
// queues on this single row and each caller gets a distinct number instead of
// two tickets reading the same "next" value. Same shape as OrgInvoiceCounter,
// but unlike a GST series gaps are fine here: a rolled-back ticket burning a
// number costs nothing, whereas CGST Rule 46 would not allow it.
model SupportTicketCounter {
  year      Int      @id
  nextSeq   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("support_ticket_counters")
}

model SupportResponse {
  id         String  @id @default(uuid())
  message    String  @db.Text
  isInternal Boolean @default(false) // Internal notes not visible to user

  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  supportTicketId String

  user   User   @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supportTicketId])
  @@index([userId])
}

model SupportTicketAttachment {
  id           String @id @default(uuid())
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  fileUrl      String
  storagePath  String

  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  ticketId String

  uploadedAt DateTime @default(now())

  @@index([ticketId])
}

// #appt-support — per-appointment support conversation (Swiggy/Zomato-style).
// One thread per (appointment, user). Channel-agnostic: messages are produced
// by a swappable resolver — a deterministic flowchart now, an AI agent later,
// a human on escalation — without changing this shape. organizationId is
// denormalized from the appointment so org admins can triage without a join.
model AppointmentSupportThread {
  id             String        @id @default(uuid())
  appointmentId  String
  appointment    Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null for pure B2C appointments; set for org-sponsored/hosted ones.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  category      SupportThreadCategory @default(OTHER)
  status        SupportThreadStatus   @default(OPEN)
  // Which resolver is currently driving the thread. SELF_SERVE = flowchart.
  activeChannel SupportChannel        @default(SELF_SERVE)
  // Current flowchart node id (null once AI/HUMAN takes over or it resolves).
  currentNodeId String?

  // A HUMAN handoff creates/links a general SupportTicket so ops works it in the
  // existing queue — no parallel ops system (one-to-one).
  supportTicketId String?        @unique
  supportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)

  messages   SupportMessage[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  resolvedAt DateTime?

  // #support-hub — denormalized last-activity clock, bumped transactionally on
  // every message write (same rationale as SupportTicket.lastMessageAt).
  lastMessageAt DateTime?

  // #705 — allocator for SupportMessage.seq. Incremented inside the same
  // transaction that writes the messages, so the row lock it takes IS the
  // serialization point between a user typing on their phone and an agent
  // replying on desktop. Free: every message write already updates this row.
  messageSeq Int @default(0)

  // One support conversation per (appointment, user) — reused across intents,
  // like a per-order support chat. Also the concurrency guard for find-or-create.
  @@unique([appointmentId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@index([status, createdAt])
  // #support-hub — the ops inbox sorts by last activity, usually status-
  // filtered; without this every page sorts the whole filtered set.
  @@index([status, lastMessageAt])
}

model SupportMessage {
  id       String                   @id @default(uuid())
  threadId String
  thread   AppointmentSupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender   SupportMessageSender
  body     String                   @db.Text
  // Resolver metadata — flow node id, AI model, action refs. Free-form.
  metadata Json?

  // #705 — createdAt alone cannot order this table. The user's turn and the
  // bot's reply are written in ONE transaction, and Postgres CURRENT_TIMESTAMP
  // is transaction START time, so they can carry a byte-identical timestamp;
  // the sort then falls to the planner and the answer renders above the
  // question. Ordering by [createdAt, id] only makes that deterministic, not
  // correct — id is a random uuid, so it would put the reply first about half
  // the time. `seq` is a strict per-thread total order from
  // AppointmentSupportThread.messageSeq. Rows written before this column keep
  // 0 and sort first, which is chronologically right: they all predate it.
  seq Int @default(0)

  // Which staff member wrote an AGENT message. NULL for USER/BOT/SYSTEM (the
  // thread's own userId identifies the user side) and for AGENT rows written
  // before this column, which honestly record "no longer known". SetNull, never
  // Cascade: a staff departure must not delete a customer's support history.
  authorUser   User?   @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorUserId String?

  createdAt DateTime @default(now())

  @@index([threadId, seq])
  @@index([threadId, createdAt])
  // Postgres does not index a foreign key for you; the SetNull scans by this.
  @@index([authorUserId])
}

// #705 — one row per TERMINAL support turn, in both scopes.
//
// "What fraction of conversations the tree resolves without a human" is the
// number that says whether the tree works — Swiggy call it bot efficacy, Airbnb
// measured it as "help 15% more people" — and it was unanswerable here, even
// after the fact: platform-scope resolutions persisted nothing at all, so a
// user self-served by the payments flow left no trace whatsoever.
//
// Deliberately NOT derived from thread status. A thread is reused across
// intents, so its final status describes the last thing that happened to it,
// not each flow run; and the platform scope has no thread to read.
//
// Carries no message bodies. This is a counter, not a transcript — the same
// separation Amazon Connect ships by construction, where the contact record
// holds counts and timings and the transcript lives somewhere else.
model SupportFlowOutcome {
  id String @id @default(uuid())

  // "APPOINTMENT" or "PLATFORM". A string rather than an enum: the scope is a
  // reporting dimension, not a state machine, and a third intake surface should
  // not need a migration to be counted.
  scope          String  @db.VarChar(32)
  // Flow registry key — SupportThreadCategory for appointment scope, the
  // PlatformFlowId for platform scope.
  flowKey        String  @db.VarChar(64)
  terminalNodeId String? @db.VarChar(64)
  // The terminal's machine-readable `reason` — the same value that types the
  // escalated ticket. Null when the walk failed safe with no terminal.
  reason         String? @db.VarChar(64)

  outcome SupportFlowOutcomeKind

  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz

  // The deflection rate itself, and the per-flow breakdown behind it.
  @@index([createdAt, outcome])
  @@index([flowKey, outcome])
  // Re-contact: deflection alone scores a user who gave up as a success, so the
  // honest reading needs "did this person come back within a few days".
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

enum SupportFlowOutcomeKind {
  /// The tree answered and the user did not need a person.
  RESOLVED
  /// The turn handed off to a human.
  ESCALATED
}

// #appt-support — per-appointment private CSAT (1-5), distinct from the public
// ConsultantReview. Gives webinar/class a feedback path they lack today and
// feeds the org-level quality signal. One per (appointment, user).
model AppointmentFeedback {
  id             String        @id @default(uuid())
  appointmentId  String
  appointment    Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  rating         Int           @db.SmallInt
  comment        String?       @db.Text

  // #705 — who is rating whom. The POST authorizes any participant, so without
  // this a consultant's rating of their OWN session is indistinguishable from
  // an attendee's and lands in the org quality average. Nullable and never
  // backfilled: rows written before this column cannot be attributed, and
  // asserting CONSULTEE over them would re-admit the very self-ratings being
  // excluded. Aggregates filter on CONSULTEE, so unknown provenance fails
  // closed.
  raterRole AppointmentFeedbackRole?

  createdAt DateTime @default(now())

  @@unique([appointmentId, userId])
  // The org aggregate filters raterRole before the date range, so
  // (organizationId, createdAt) is no longer a usable prefix for it.
  @@index([organizationId, raterRole, createdAt])
}

enum AppointmentFeedbackRole {
  CONSULTEE
  PROVIDER
}

enum SupportThreadStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

// Which resolver drives the thread. The interface is identical across all three
// so a thread can move SELF_SERVE → AI → HUMAN without a data change.
enum SupportChannel {
  SELF_SERVE
  AI
  HUMAN
}

enum SupportMessageSender {
  USER
  BOT
  AGENT
  SYSTEM
}

// The support intent — selects which flowchart runs. SPONSORSHIP_BILLING and
// ORG_ADMIN_DISPUTE are the B2B-only intents (offered by context).
enum SupportThreadCategory {
  CANCEL_REFUND
  RESCHEDULE
  NO_SHOW
  TECHNICAL
  // #support-hub review — session materials (handouts, pre-reads). DOCUMENT_ISSUE
  // was session-scoped (so refused on the platform form) with no appointment
  // flow to send anyone to; this is that flow's category.
  DOCUMENTS
  PAYMENT_STATUS
  RECORDING_ACCESS
  QUALITY_COMPLAINT
  SPONSORSHIP_BILLING
