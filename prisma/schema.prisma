  // Education and work experience are at User level (WorkExperience, Education models)

  consultationRequests Consultation[]
  subscriptionRequests Subscription[]
  consultantReviews    ConsultantReview[]
  trialSessions        TrialSession[]

  user   User   @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userId String @unique

  // Enterprise: optional org memberships as MEMBER/LEARNER role.
  memberships   Membership[] @relation("ConsulteeMembership")
  isIndependent Boolean      @default(true)

  /// #1365 — the buyer's GST state (2-digit numeric), remembered from checkout
  /// so a repeat buyer is never asked twice. Sec 12(2)(b) IGST Act makes this
  /// optional: null means the supply is placed at the supplier's own location,
