{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "-p", "@modelcontextprotocol/sdk",
        "-p", "zod",
        "-p", "@supabase/mcp-server-supabase@0.8.1",
        "mcp-server-supabase"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "<SUPABASE_ACCESS_TOKEN>"
      }
    },
    "rzp-mcp-server": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://mcp.razorpay.com/mcp",
        "--header",
        "Authorization: Basic <RZP_MCP_SERVER_BASIC_AUTH_TOKEN>"
      ]
    },
    "stripe": {
      "command": "npx",
      "args": ["-y", "@stripe/mcp", "--tools=all"],
      "env": {
        "STRIPE_SECRET_KEY": "<STRIPE_SECRET_KEY>"
      }
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena-mcp-server"
      ]
    },
    "directus": {
      "command": "npx",
      "args": ["-y", "@directus/content-mcp@latest"],
      "env": {
        "DIRECTUS_URL": "https://your-project.directus.app",
        "DIRECTUS_TOKEN": "your-directus-admin-token"
      }
    },
    "streamio": {
      "command": "npx",
      "args": ["-y", "unofficial-streamio-mcp-server@latest"],
      "env": {
        "STREAM_API_KEY": "${STREAM_API_KEY}",
        "STREAM_API_SECRET": "${STREAM_API_SECRET}"
      }
    },
    "betterstack": {
      "type": "http",
      "url": "https://mcp.betterstack.com"
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    }
  }
}
